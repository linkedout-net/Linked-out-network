# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it's already in .gitignore.
#
# NOTE — not an env var, a system dependency: video/audio attachment
# transcoding (lib/transcode.js) needs the `ffmpeg` binary on PATH.
# Nothing to set here for it, but your production host needs it
# installed (`apt install ffmpeg` or equivalent) — see README's "What's
# mocked" section for why this matters more on serverless hosts.

# --- Database (PostgreSQL — see DEPLOYMENT.md) ---
# Both the identity and content stores connect here by default (as two
# separate SQL schemas within one database — see lib/db/pg-client.js).
# Format: postgres://user:password@host:port/dbname
DATABASE_URL=

# Optional: point either store at a genuinely separate Postgres
# instance/database instead of sharing DATABASE_URL, for a stronger
# physical (not just logical) separation between the PII store and the
# content store. Leave unset to use DATABASE_URL for both.
IDENTITY_DATABASE_URL=
CONTENT_DATABASE_URL=

# Set to "disable" only for a local, non-TLS Postgres (e.g. `docker run
# postgres` on your own machine). Every managed provider (Railway, Fly
# Postgres, Supabase, Neon, RDS...) needs TLS — leave this unset there.
PGSSL=

# --- Object storage (Backblaze B2 — see DEPLOYMENT.md § Object Storage) ---
# Post/comment media and avatars go to the PUBLIC bucket; government-ID /
# business / professional verification documents go to the PRIVATE
# bucket and are only ever reachable via a short-lived signed URL — see
# lib/storage.js.
#
# From your B2 account: Application Keys → Add a New Application Key,
# scoped to both buckets below (or a master key for local dev).
B2_KEY_ID=
B2_APPLICATION_KEY=
# The S3-compatible endpoint for your B2 region, e.g.
# https://s3.us-west-004.backblazeb2.com — shown on the bucket's details
# page in the B2 dashboard.
B2_ENDPOINT=
B2_REGION=us-west-004
# Create these two buckets in the B2 dashboard: the first set to
# "Public", the second set to "Private". Names must be globally unique
# across all of B2, so you'll need your own prefix (e.g.
# yourapp-media-public).
B2_BUCKET_PUBLIC=
B2_BUCKET_PRIVATE=
# Optional: a CDN or custom domain (e.g. https://media.yourdomain.com)
# fronting B2_BUCKET_PUBLIC, instead of serving B2's own URL directly.
# Cuts egress cost and lets you use your own domain for media links. See
# DEPLOYMENT.md for the exact Cloudflare setup. Leave unset to use B2's
# native public URL.
B2_PUBLIC_URL_BASE=

# --- Real seed-content images (optional — see scripts/lib/stock-photos.js) ---
# Free API key from pexels.com/api (no card required). Without this, the
# seed script's placeholder post images fall back to solid color blocks
# instead of real, topic-relevant photos.
PEXELS_API_KEY=

# Signs session cookies and content tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Falls back to an insecure dev default if unset — fine for local dev,
# not fine for anything with real users.
IDENTITY_SIGNING_SECRET=

# Used to build Stripe success/cancel URLs, OAuth redirect URIs, and
# links inside emails (verification, password reset). No trailing slash.
# Change this to your real domain once deployed.
NEXT_PUBLIC_APP_URL=http://linkedoutnetwork.com

# --- Stripe (see README § Stripe setup for the full walkthrough) ---
# Secret key from https://dashboard.stripe.com/apikeys (use your live key, sk_live_...).
STRIPE_SECRET_KEY=

# Price IDs (price_...) for the two paid plans, created in the Stripe
# Dashboard under Product Catalog as recurring monthly prices. Basic is
# free and has no Stripe price. The amounts you set in Stripe are what
# customers are actually charged — keep them matching the display prices in
# app/premium/page.js (Plus $4.99, Pro $9.99 by default).
STRIPE_PLUS_PRICE_ID=
STRIPE_PRO_PRICE_ID=
# Annual Prices (OUT+ $158.29/yr, OUT PRO $369.49/yr). Create them on the same products as the monthly ones.
STRIPE_PLUS_ANNUAL_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=

# Plus and Pro require a verified email AND phone before checkout
# (enforced server-side).

# Postgres connections per pool (identity + content each get one). Raise
# only if you see connection-wait timeouts under real load.
PG_POOL_MAX=20

# Signing secret for the webhook endpoint, from either the Stripe
# Dashboard (Developers → Webhooks) or the Stripe CLI (`stripe listen`
# prints one starting with whsec_...).
STRIPE_WEBHOOK_SECRET=

# --- Resend (transactional email — see README § Email setup) ---
# API key from https://resend.com/api-keys. Without this, welcome/
# verification/password-reset emails are logged to the console instead of
# sent — nothing breaks, you just won't get a real email.
RESEND_API_KEY=

# Must be a domain you've verified in Resend, e.g. "LinkedOut <noreply@yourdomain.com>".
# The default onboarding@resend.dev sender works for quick testing but is
# rate-limited and not meant for real use.
RESEND_FROM_EMAIL=

# Optional but recommended for email BROADCASTS from the admin dashboard:
# where replies go, and your postal address (shown in the footer of marketing email —
# required by CAN-SPAM and good practice under GDPR).
RESEND_REPLY_TO=
EMAIL_FOOTER_ADDRESS=

# --- Push notifications (Expo) — see PUSH_SETUP.md for the full walkthrough ---
# From expo.dev → Account settings → Access tokens. Turns on Expo's "enhanced security"
# so only YOUR server can send pushes to your app's devices. Sending works without it, but
# set it for production.
EXPO_ACCESS_TOKEN=
# Set to 1 to switch every push off (e.g. on a staging copy that shares real device tokens).
DISABLE_PUSH=

# --- Scheduled broadcasts ---
# On a long-running host (Fly.io / Docker / VPS — what this project deploys to) scheduled admin
# broadcasts are sent automatically every minute; nothing to set. On a serverless host, set a
# long random value here and have a scheduler call
#   GET {NEXT_PUBLIC_APP_URL}/api/cron/broadcasts   with header   Authorization: Bearer <this value>
# every minute. Generate one: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CRON_SECRET=

# --- Google Sign-In (see README § Google Sign-In setup) ---
# From https://console.cloud.google.com/apis/credentials — create an
# OAuth 2.0 Client ID (type: Web application). Add
# {NEXT_PUBLIC_APP_URL}/api/auth/google/callback as an authorized
# redirect URI there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only needed if it should differ from the default derived from
# NEXT_PUBLIC_APP_URL above.
GOOGLE_REDIRECT_URI=
# Optional, for the native app's "Android client" sign-in mode (Google Sign-In SDK). The app signs in with
# the WEB client above as its webClientId, so tokens already match GOOGLE_CLIENT_ID. Only set this if you
# configure a build to use the Android client id directly (comma-separate several).
GOOGLE_ANDROID_CLIENT_ID=

# --- Apple Sign In (see README § Apple Sign In — genuinely needs a paid ---
# --- Apple Developer Program membership; code here is untested without one) ---
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# The full contents of your .p8 private key file, PEM-formatted,
# including the -----BEGIN/END PRIVATE KEY----- lines.
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=

# --- LiveKit (real Vent Room audio — see README § Vent Room audio setup) ---
# Self-host (https://docs.livekit.io/home/self-hosting/) or create a free
# project at https://cloud.livekit.io. Without these three set, Vent
# Rooms fall back to the identity-only waiting room — nothing breaks.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=

# --- GIFs in replies (KLIPY — Tenor's API shut down 2026-06-30) ---
# Free key: https://partner.klipy.com -> API Keys -> Create Key
# Optional fallback provider: GIPHY (https://developers.giphy.com).
# With neither set, the GIF picker says GIF search isn't available.
KLIPY_API_KEY=
GIPHY_API_KEY=

# --- SMS verification codes (Telnyx — see lib/sms.js, lib/identity/phone-otp.js) ---
# Codes are generated and checked by our own database; Telnyx only delivers
# the text. Create a v2 API key + a sending number (or messaging profile)
# at https://portal.telnyx.com.
TELNYX_API_KEY=
TELNYX_FROM_NUMBER=
TELNYX_MESSAGING_PROFILE_ID=
# Code lifetime in minutes (default 10).
OTP_TTL_MINUTES=10
# Fraud controls (all optional). Comma-separated calling codes, no plus:
#   SMS_ALLOWED_COUNTRY_CODES=254,1,44   -> only these countries
#   SMS_BLOCKED_COUNTRY_CODES=           -> never these
SMS_ALLOWED_COUNTRY_CODES=
SMS_BLOCKED_COUNTRY_CODES=
# Circuit breakers against SMS pumping: max code texts per hour to any one
# country prefix, and in total.
SMS_PREFIX_HOURLY_CAP=40
SMS_GLOBAL_HOURLY_CAP=300

# ---- AI features (Title Translator, Roast My Resume, AI outreach) ----
# Pick ONE provider. Anthropic is the default; any OpenAI-compatible service also works.
# AI_PROVIDER=anthropic          # anthropic | openai | gemini
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=                # OpenAI, or Groq / OpenRouter / Together / Mistral / DeepSeek / Ollama...
# OPENAI_BASE_URL=https://api.openai.com/v1
# GEMINI_API_KEY=
# AI_MODEL=                      # optional override of the provider's default model

# ---- Business plans (a company page subscribes). Create these Prices in Stripe, same product per plan.
STRIPE_BUSINESS_PRICE_ID=            # $199 / month
STRIPE_BUSINESS_ANNUAL_PRICE_ID=     # $2,101.44 / year
STRIPE_BUSINESS_PRO_PRICE_ID=        # $499 / month
STRIPE_BUSINESS_PRO_ANNUAL_PRICE_ID= # $5,269.44 / year

# ---- Search engines (see SEO-GUIDE.md)
GOOGLE_SITE_VERIFICATION=            # the token from Google Search Console's "HTML tag" method
BING_SITE_VERIFICATION=              # optional, Bing Webmaster Tools
NEXT_PUBLIC_SOCIAL_LINKS=            # comma-separated profile URLs (X, LinkedIn, Instagram...) used as schema.org sameAs

# Where new contact-form / support messages are emailed (your own inbox). Optional but recommended:
# the admin dashboard queue is the source of truth, this just makes sure you notice.
SUPPORT_INBOX_EMAIL=
# Public support address shown on the Help & Support page and in the app (e.g. support@yourdomain.com).
NEXT_PUBLIC_SUPPORT_EMAIL=
# Google Play listing link. Leave empty until the app is live: the site shows "coming soon" until it is set.
NEXT_PUBLIC_PLAY_STORE_URL=

# --- Mobile app links (served at /.well-known/assetlinks.json and apple-app-site-association) ---
ANDROID_PACKAGE_NAME=com.linkedoutnetwork.linkedout
# Comma-separated SHA-256 certificate fingerprints (Play App Signing key + your upload key).
ANDROID_SHA256_FINGERPRINTS=
APPLE_TEAM_ID=
IOS_BUNDLE_ID=com.linkedoutnetwork.linkedout

# --- Your registered organisation (shown on Terms, Privacy and Help & Support; needed for an organization Play account) ---
NEXT_PUBLIC_COMPANY_LEGAL_NAME=
NEXT_PUBLIC_COMPANY_ADDRESS=
NEXT_PUBLIC_COMPANY_REG_NO=

# ---- Security (all optional; see docs/SECURITY-OPERATIONS.md) ----
# SECRETS_MASTER_KEY=            # openssl rand -base64 32  (vault + field encryption key)
# SECURITY_INTERNAL_KEY=         # optional; derived from IDENTITY_SIGNING_SECRET if unset
# SECURITY_PROXY=off             # emergency switch: disables the WAF/blocklist layer in proxy.js
# PGSSL_VERIFY=true              # verify the Postgres certificate (add PG_CA_CERT if your provider needs it)
# TURNSTILE_SITE_KEY=            # Cloudflare Turnstile (CAPTCHA)
# TURNSTILE_SECRET=
# CAPTCHA_ALWAYS=false
# ABUSEIPDB_KEY=                 # IP reputation feed
# SIEM_WEBHOOK_URL=              # or store in the Vault
# SIEM_WEBHOOK_TOKEN=
# SIEM_SIGNING_SECRET=
# OIDC_ISSUER=                   # staff SSO
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_ALLOWED_DOMAINS=yourcompany.com
# OIDC_REQUIRE_MFA=false
# NEXT_PUBLIC_SSO_ENABLED=true
# APP_ORIGIN=https://your-domain   # used for SSO redirects and security keys
# WEBAUTHN_RP_ID=your-domain       # only if the site is served from a different host than the one staff use
# MIN_APP_VERSION=                 # staff on older native builds are marked non-compliant
# POSTURE_STRICT=false             # true = staff devices must have reported posture at least once
